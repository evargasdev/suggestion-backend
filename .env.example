# ============================================================
# Variables de entorno para la API de sugerencias
# Copia este archivo a `.env` y ajusta los valores.
# ============================================================

# --- HTTP server ----------------------------------------------------------
# Puerto HTTP (default: 3000)
# PORT=3000

# Prefijo global (default: api/v1)
# GLOBAL_PREFIX=api/v1

# Swagger UI. Solo acepta `true`/`false` (case-insensitive). Si el valor
# no es reconocible, se aplica el default seguro: `false` en producción,
# `true` en cualquier otro entorno.
# ENABLE_SWAGGER=true

# --- Conexión a Postgres --------------------------------------------------
# La conexión es OBLIGATORIA al iniciar; no existe flag para
# desactivarla. Configura una de las dos opciones.
#
# Opción A: variable única (recomendada)
# DATABASE_URL=postgres://user:pass@localhost:5432/suggestion

# Opción B: variables individuales (usadas si DATABASE_URL está vacío)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=suggestion
# DB_PASSWORD=suggestion
# DB_NAME=suggestion

# Esquema de Postgres (default: public)
# DB_SCHEMA=public

# PELIGROSO en producción: deja `false`. TypeORM sincroniza el schema
# automáticamente desde las entidades, lo cual puede BORRAR DATOS.
# En NODE_ENV=production se fuerza a `false` aunque lo actives.
# DB_SYNCHRONIZE=false

# Marcado como no implementado. Las migraciones reales son archivos
# SQL en `migrations/*.sql` y deben aplicarse con `psql`. Activar este
# flag NO ejecuta ningún script hasta que se añada una migración
# TypeORM (`.ts` o `.js`) registrada en el DataSource.
# DB_RUN_MIGRATIONS=false

# --- NODE_ENV --------------------------------------------------------------
# Controla defaults (Swagger) y bloqueos (DB_SYNCHRONIZE).
# NODE_ENV=development